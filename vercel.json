{
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "review-dist",
  "installCommand": "npm ci",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "functions": {
    "api/arrivals.py": {
      "includeFiles": "{server/**,src/data/stations.json,src/data/bis-verification-budget.json}"
    }
  }
}
